# Step Out - Environment Configuration

# --- Default: Groq Hosted Open Weights ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
PLAN_MODEL=llama-3.3-70b-versatile
NOTES_MODEL=llama-3.1-8b-instant
STT_MODEL=whisper-large-v3-turbo

# --- Alternative: Fully Local (Ollama + faster-whisper-server) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# PLAN_MODEL=llama3.1:8b
# NOTES_MODEL=llama3.1:8b
# # Local Whisper requires an OpenAI-compatible STT endpoint (e.g. faster-whisper-server on port 8000)
# STT_BASE_URL=http://localhost:8000/v1
# STT_MODEL=whisper-1
